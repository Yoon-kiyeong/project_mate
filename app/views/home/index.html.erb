<% if user_signed_in? %>
    <!-- 1. ログインしたユーザーのみ見せるメイン画面 -->
    <h2> ようこそ, <%= current_user.email %> 様! </h2>
    <p>ProjectMateにログインが成功しました。</p>

    <div style="margin-top: 20px;">
        <%= link_to "ログアウト", destroy_user_session_path, data: { turbo_method: delete} %>
    </div>

<% else %>
    <!-- 2. ログインしないユーザーのみ見せるメイン画面 -->
    <h2>ProjectMateへようこそ！</h2>
    <p>サービスを利用するためには、ログインや   新規登録が必要です。</p>
    
    <div style="margin-top: 20px;">
        <%= link_to "ログイン", new_user_session_path, data: { turbo: false } %> |
        <%= link_to "新規登録", new_user_registration_path, data: { turbo: false } %>
    </div>
<% end %>